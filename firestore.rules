rules_version = '2';

// Cada pessoa só pode ler e alterar a sua própria lista (documento users/{uid}).
// Copiar para: Firebase → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
